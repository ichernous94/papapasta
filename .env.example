# Local PostgreSQL; use your existing database/credentials.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE

# Generate once: openssl rand -base64 48. Keep stable and secret.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://admin.localhost:3000
# Production: https://admin.papapasta.pl
# Temporary deployment: https://admin.workbase.sbs

# Optional until image uploads are enabled. Do not commit real values.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
